rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Mismos administradores autorizados en Login.jsx. Sin lecturas extra de roles.
      allow read, write: if request.auth != null && request.auth.uid in [
        'Co7Rg2ANZFRoCxhrK9JaHJOl2zR2',
        'Bk51tX4d7VXkjg9octa5yDUgGOr1',
        'XQcRWLm56WdX5t6lcuRrKuYZxu42'
      ];
    }
  }
}
